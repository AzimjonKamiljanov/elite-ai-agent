#!/bin/bash
# JARVIS Prime — Linux/macOS launcher
set -e
cd "$(dirname "$0")"

if ! command -v python3 &> /dev/null; then
    echo "❌ python3 not found. Install Python 3.11+: https://www.python.org/downloads/"
    exit 1
fi

# Try venv first, fall back to system python
if [ -f ".venv/bin/python" ]; then
    source .venv/bin/activate
elif [ -f "runtime/venv/bin/python" ]; then
    source runtime/venv/bin/activate
fi

exec python3 -m apps.cli "$@"

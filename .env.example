# ==============================================================================
# JARVIS-X Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Providers (Multi-LLM Orchestration)
# ------------------------------------------------------------------------------
# Add at least one API key to start using the AI functionalities.
# Multiple providers can be configured to enable the automatic fallback system.

GEMINI_API_KEY_1=your_gemini_api_key_1_here
# GEMINI_API_KEY_2=your_gemini_api_key_2_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ------------------------------------------------------------------------------
# 2. Life Assistant Preferences
# ------------------------------------------------------------------------------
JARVIS_WAKE_UP_TIME=07:00
JARVIS_CLASS_ALERT_MINUTES=15

# ------------------------------------------------------------------------------
# 3. Memory & Storage (RAG + Long-term Memory)
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/memory

# ------------------------------------------------------------------------------
# 4. Voice Configuration (Optional)
# ------------------------------------------------------------------------------
# Set to true and ensure whisper/piper dependencies are installed for voice
VOICE_ENABLED=false

# ------------------------------------------------------------------------------
# 5. External Integrations (Optional)
# ------------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here
